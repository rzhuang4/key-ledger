---
import { features } from '../i18n/features';
import { localeInfo } from '../i18n/locales';
import { formatRange, formatReviewed } from '../lib/labels';

interface Props {
  locale: string;
  unverifiedLabel: string;
  compactService?: boolean;
  row: {
    status: string;
    currency?: string;
    retailer?: string;
    checkedAt?: string;
    stock?: string;
    stockBasis?: string;
    lowUsd?: number;
    highUsd?: number;
    note?: string | { text: string };
  };
}
const { locale, row, unverifiedLabel, compactService = false } = Astro.props;
const noteText = typeof row.note === 'string' ? row.note : row.note?.text;
const copy = features(locale);
const info = localeInfo(locale);
const stockBase =
  row.stock === 'in-stock' ? copy.stockIn :
  row.stock === 'out-of-stock' ? copy.stockOut :
  row.stock === 'service' ? copy.stockService :
  row.stock === 'not-listed' ? copy.stockNotListed :
  copy.stockUnknown;
const stock =
  (row.stock === 'in-stock' || row.stock === 'out-of-stock') &&
  (row.stockBasis === 'shopify-js' || row.stockBasis === 'json-ld') &&
  row.checkedAt
    ? `${stockBase} (product data, ${row.checkedAt})`
    : stockBase;
const retailer = !row.retailer || row.retailer === 'none' ? copy.noRetailer : row.retailer;
const showUsd =
  row.status === 'verified' &&
  row.currency === 'USD' &&
  (row.stock !== 'service' || compactService);
---

<div class:list={['price-fact', { service: row.stock === 'service' }]}>
  {
    row.stock === 'service' && noteText && !compactService ? (
      <span class="pack">{noteText}</span>
    ) : (
      <>
        <span>{retailer}</span>
        {
          showUsd ? (
            <span><span class="mono">USD</span> {formatRange(row.lowUsd, row.highUsd)}</span>
          ) : (
            <span class="chip unverified">{unverifiedLabel}</span>
          )
        }
      </>
    )
  }
  <span>{stock}</span>
  {(row.stock !== 'service' || compactService) && row.checkedAt && <span class="muted">{copy.checkedOn.replace('{date}', formatReviewed(row.checkedAt, info.dateLocale))}</span>}
  {retailer === 'Standard Auto Part' && showUsd && <span class="pack">{copy.sapPackNote}</span>}
</div>
